# ========================================================
# SiteReportX 환경 변수 설정 템플릿 (.env.example)
# 복사하여 .env 파일을 만들고 필요한 API 키를 입력하세요.
# ========================================================

# 1. AI 엔진 설정 (Gemini API 키 권장)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. 선택적 AI 키 (OpenAI / Google Vision)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json

# 3. 서버 설정 (기본값)
HOST=0.0.0.0
PORT=8000
